node_modules/
.claude/CLAUDE.md
.claude/settings.json
.claude/settings.local.json
.env
.DS_Store
._*

# Bun transient compilation artifacts
*.bun-build

# Generated AI-DLC projections (materialized locally by scripts/package.ts)
/dist/
/dist-release/
build/

# Zensical documentation-site build output and env (`uv run zensical build`;
# deployed by .github/workflows/docs.yml, never committed)
/site/
/.cache/
/.venv/

# Test verbose logs
tests/logs/

# The coverage registry: tests/gen-coverage-registry.ts builds it fresh; never committed
tests/.coverage-registry.json

# Claude worktrees
.claude/worktrees

# AIDLC runtime state (Construction worktrees + future runtime artefacts).
# Anchored to repo root; distinct from .claude/worktrees above which is
# the framework-development worktree convention.
/.aidlc/
/aidlc/spaces/*/intents/.aidlc-*

# Local scratch — explainers, throwaway HTML, etc. (claude writes explainers here)
tmp/

# RFC drafts and implementation plans are working notes, never documentation.
# Draft them in tmp/ (or a GitHub issue via the RFC template); docs/ never
# carries an rfcs/ directory.
/docs/rfcs/

# Local Claude Code memory (personal project preferences, not checked in)
CLAUDE.local.md

# Local-only — pins shfmt formatting to project style via a local
# auto-format tool. Not committed; contributors who do not use it do not need it.
.editorconfig

# Local-only formatter/linter cache — match at any depth so a cache
# directory anywhere in the repo (root, dist/, tools/, etc.) is ignored.
**/.pi-lens/
.pi-lens/

# BEGIN AI-DLC:gitignore
# AI-DLC: local working files
aidlc/active-space
aidlc/spaces/*/intents/active-intent
aidlc/.aidlc-clone-id
aidlc.settings.local.json
aidlc/.aidlc-unit-scope.json
aidlc/.aidlc-unit-parked
aidlc/.aidlc-claim-generations.json
aidlc/.aidlc-unit-participant
aidlc/.aidlc-claim-registry.json
aidlc/.aidlc-unit-releases/
aidlc/.aidlc-unit-merges/
aidlc/.aidlc-active-space-*.tmp
aidlc/active-memory/
aidlc/.aidlc-sessions/
aidlc/.aidlc-request-text/
aidlc/spaces/*/intents/.aidlc-*
**/aidlc/spaces/*/intents/**/.aidlc-engine/
**/aidlc/spaces/*/intents/**/.aidlc-sensors/
aidlc/spaces/*/knowledge/documentkb/.journal/
aidlc/spaces/*/knowledge/.sources.local.json
aidlc/spaces/*/intents/*/runtime-graph.json
aidlc/spaces/*/intents/*/.aidlc-*
aidlc/diagnostics/
.claude/settings.local.json
.aidlc/
.hermes/
# END AI-DLC:gitignore
